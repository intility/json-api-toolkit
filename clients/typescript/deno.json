{
  "name": "@intility/json-api-client",
  "version": "0.6.0",
  "description": "TypeScript tools for JSON:API: response hydration, a type-safe query builder, and error types for JsonApiToolkit backends.",
  "license": "MIT",
  "exports": "./src/index.ts",
  "publish": {
    "exclude": [
      "contract/",
      "dist/",
      "build_npm.ts",
      "CLAUDE.md",
      "CODEOWNERS",
      "CHANGELOG.md",
      "deno.lock",
      "**/*_test.ts"
    ]
  },
  "tasks": {
    "check": "deno check src/**/*.ts contract/**/*.ts",
    "lint": "deno lint --ignore=README.md,.github/,CLAUDE.md,CODEOWNERS,CHANGELOG.md",
    "fmt": "deno fmt --check --ignore=README.md,.github/,CLAUDE.md,CODEOWNERS,CHANGELOG.md",
    "fmt:fix": "deno fmt --ignore=README.md,.github/,CLAUDE.md,CODEOWNERS,CHANGELOG.md",
    "test": "deno test src/",
    "test:contract": "deno test --allow-net --allow-env contract/",
    "build": "deno run -A build_npm.ts"
  },
  "imports": {
    "@deno/dnt": "jsr:@deno/dnt@^0.41.3",
    "@std/assert": "jsr:@std/assert@^0.226.0"
  },
  "fmt": {
    "singleQuote": true,
    "indentWidth": 2,
    "exclude": [
      "README.md",
      "CLAUDE.md",
      "CODEOWNERS",
      "CHANGELOG.md"
    ]
  }
}
