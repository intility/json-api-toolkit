{
  "$schema": "https://raw.githubusercontent.com/dotnet/docfx/main/schemas/docfx.schema.json",
  "metadata": [
    {
      "src": [
  {
    "src": "./JsonApiToolkit",
    "files": [
      "bin/Release/net9.0/JsonApiToolkit.dll"
    ]
  }
],
      "dest": "api",
      "properties": {
        "TargetFramework": "net9.0",
        "RoslynLanguageVersion": "9.0"
      }
    }
  ],
  "build": {
    "content": [
      {
        "files": [
          "**/*.{md,yml}"
        ],
        "exclude": [
          "_site/**"
        ]
      }
    ],
    "resource": [
      {
        "files": [
          "images/**"
        ]
      }
    ],
    "output": "_site",
    "template": [
      "default",
      "modern"
    ],
    "globalMetadata": {
      "_appName": "Intility.JsonApiToolkit",
      "_appTitle": "Intility.JsonApiToolkit",
      "_enableSearch": true,
      "pdf": true
    }
  }
}
