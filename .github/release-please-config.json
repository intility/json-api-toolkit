{
  "$schema": "https://raw.githubusercontent.com/googleapis/release-please/refs/heads/main/schemas/config.json",
  "packages": {
    ".": {
      "release-type": "simple",
      "package-name": "Intility.JsonApiToolkit",
      "include-component-in-tag": false,
      "changelog-sections": [
